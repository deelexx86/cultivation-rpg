; P0 probe remains the default. --p1-demo opens the simulation laboratory.
config_version=5

[application]
config/name="Cultivation RPG - P0"
config/version="0.1.0-p1"
run/main_scene="res://scenes/foundation.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]
window/size/viewport_width=960
window/size/viewport_height=640
window/stretch/mode="canvas_items"

[gui]
theme/default_font_multichannel_signed_distance_field=true

[rendering]
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.075, 1)
